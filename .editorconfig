# Editor and tooling defaults for the whole repository.
# Line endings are additionally enforced by .gitattributes.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{java}]
indent_style = space
indent_size = 4

[*.{js,jsx,json,yml,yaml,css,html}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
