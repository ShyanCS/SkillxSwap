# SkillSwap production environment.
# Copy to `.env`, fill in real values, and keep `.env` out of version control.
#
#   cp .env.example .env
#
# The backend refuses to start in prod if any required value below is missing
# or obviously insecure (see ProductionConfigValidator).

# ---------------------------------------------------------------- core
SPRING_PROFILES_ACTIVE=prod
SERVER_PORT=8080

# ---------------------------------------------------------------- database
# When using docker-compose.prod.yml the host is the service name `db`.
DB_URL=jdbc:postgresql://db:5432/skillswap
DB_USERNAME=skillswap
DB_PASSWORD=            # REQUIRED - generate a strong password
DB_POOL_MAX=10
DB_POOL_MIN=2

# Consumed by the postgres container itself; keep in sync with the values above.
POSTGRES_DB=skillswap
POSTGRES_USER=skillswap
POSTGRES_PASSWORD=      # REQUIRED - must match DB_PASSWORD

# ---------------------------------------------------------------- auth
# REQUIRED. Generate with:  openssl rand -base64 48
# Rotating this immediately invalidates every active session.
JWT_SECRET=
JWT_EXPIRATION_MS=604800000        # 7 days

# "Lax" is correct when the frontend and API share a registrable domain
# (app.example.com + api.example.com). Use "None" only for a genuinely
# different domain; None requires Secure, which prod already forces on.
COOKIE_SAME_SITE=Lax

# ---------------------------------------------------------------- cors
# REQUIRED. Comma-separated, https only, no wildcards.
CORS_ALLOWED_ORIGINS=https://skillswap.example.com

# ---------------------------------------------------------------- email
# Any SMTP provider (Brevo, SES, SendGrid, Postmark, Mailgun...). Used for OTP
# verification codes and notification emails.
#
# Brevo (https://app.brevo.com -> SMTP & API -> SMTP):
#   MAIL_HOST=smtp-relay.brevo.com
#   MAIL_PORT=587
#   MAIL_USERNAME=<the "Login" shown there, e.g. 8a1b2c001@smtp-brevo.com>
#   MAIL_PASSWORD=<an SMTP key you generate there -- NOT your account password>
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# The address recipients actually see. This is NOT MAIL_USERNAME: with a relay,
# the username is a credential, while this must be an address the provider has
# verified as a sender (Brevo: Senders -> Add a sender, then confirm by email).
# Sending from an unverified address gets rejected or silently spam-filed.
MAIL_FROM=
MAIL_FROM_NAME=SkillSwap

# ---------------------------------------------------------------- ai assistant
# Optional. When disabled, the Ask AI feature returns a clear "unavailable"
# response instead of failing. Key: https://aistudio.google.com/apikey
AI_ENABLED=false
GEMINI_API_KEY=
# Newest is not most available: on a free-tier key the newest ids are heavily
# rate-limited (429) and the `-latest` aliases see demand spikes (503), while
# gemini-3.5-flash answered every call. If the AI page starts failing, check the
# logs for a 404 naming this model -- that means Google retired it.
# List what your key can use:
#   curl -H "x-goog-api-key: $GEMINI_API_KEY" \
#     https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODEL=gemini-3.5-flash

# ---------------------------------------------------------------- photo upload
# Optional. Without these, profile photo upload is disabled but the rest of
# the profile still works.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------- redis (scaling)
# Only needed to run more than one API replica. Redis shares rate-limit buckets
# and real-time message fan-out across instances; without it each replica keeps
# its own, so the effective rate limit multiplies by the replica count and a
# WebSocket client only receives events raised on the instance it connected to.
#
# Leave disabled for a single-instance deployment -- it buys nothing there.
# Start the container with:  docker compose ... --profile scale up -d
REDIS_ENABLED=false
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=         # REQUIRED when REDIS_ENABLED=true

# ---------------------------------------------------------------- admin
# Grants ADMIN to this (already registered) account on startup. Register the
# email through the normal signup flow first, then set this and restart.
# Safe to leave set; it is a no-op once the role is granted.
ADMIN_BOOTSTRAP_EMAIL=

# ---------------------------------------------------------------- rate limits
# Per client IP. Tighten these if you see abuse.
RATELIMIT_OTP_PER_HOUR=5
RATELIMIT_LOGIN_PER_15MIN=10
# Keep low on Gemini's free tier: it allows only ~20 requests/day/model across
# the whole project, so one user can otherwise exhaust it for everyone.
RATELIMIT_AI_PER_HOUR=5

# ---------------------------------------------------------------- logging
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=INFO

# ---------------------------------------------------------------- error tracking
# Optional, frontend-only for now. Without a DSN nothing is sent and no
# network calls are made. Create a project at https://sentry.io to get one.
# Backend error tracking is pending Sentry shipping a Spring Boot 4-compatible
# starter; until then backend errors surface through structured JSON logs.
VITE_SENTRY_DSN=

# ---------------------------------------------------------------- frontend
# Baked into the frontend bundle at build time (Vite inlines VITE_* vars).
VITE_API_BASE_URL=https://api.skillswap.example.com
